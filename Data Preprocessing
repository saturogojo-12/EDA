import pandas as pd
import numpy as np
from sklearn.preprocessing import StandardScaler, OneHotEncoder
from sklearn.model_selection import train_test_split
from sklearn.compose import ColumnTransformer
from sklearn.pipeline import Pipeline

# Load the raw data
df = pd.DataFrame({
    'price': [450000, 320000, None, 675000, 280000, 890000, 410000, 520000, None, 750000],
    'bedrooms': [3, 2, 4, 5, 2, 4, 3, 3, 2, 5],
    'bathrooms': [2.0, 1.0, 2.5, None, 1.0, 3.0, 2.0, 2.0, 1.5, 3.5],
    'sqft': [1800, 1200, 2400, 3200, 950, 2800, 1700, 1950, 1100, 3500],
    'year_built': [2005, 1998, None, 2015, 1975, 2020, 2008, 2012, 2002, 2018],
    'location': ['NY', 'NJ', 'NY', 'CA', 'TX', 'CA', 'NY', 'NJ', 'TX', 'CA'],
    'condition': ['Good', 'Fair', None, 'Excellent', 'Poor', 'Good', 'Fair', 'Good', None, 'Excellent'],
    'sale_date': ['2023-01-15', '2023-02-10', '2023-01-20', '2023-03-05', '2023-01-30',
                  '2023-02-28', '2023-03-10', '2023-01-25', '2023-02-15', '2023-03-20']
})

print("=== RAW DATA ===")
print(df)
print("\nMissing values:\n", df.isnull().sum())


# 1.1 Drop rows where target variable (price) is missing
df = df.dropna(subset=['price'])

# 1.2 Fill missing numeric values with median (more robust than mean)
df['bathrooms'].fillna(df['bathrooms'].median(), inplace=True)
df['year_built'].fillna(df['year_built'].median(), inplace=True)

# 1.3 Fill missing categorical values with mode (most frequent value)
df['condition'].fillna(df['condition'].mode()[0], inplace=True)

print("\n=== AFTER HANDLING MISSING VALUES ===")
print(df)
print("\nMissing values now:\n", df.isnull().sum())

# 2.1 Extract features from date
df['sale_date'] = pd.to_datetime(df['sale_date'])
df['sale_month'] = df['sale_date'].dt.month
df['sale_year'] = df['sale_date'].dt.year

# 2.2 Create new feature: house age at time of sale
df['house_age'] = df['sale_year'] - df['year_built']

# 2.3 Create new feature: price per square foot (useful for analysis)
df['price_per_sqft'] = df['price'] / df['sqft']

# 2.4 Create new feature: bedrooms_bathrooms_ratio
df['bed_bath_ratio'] = df['bedrooms'] / df['bathrooms']

# Drop original date columns
df.drop(['sale_date', 'year_built', 'sale_year'], axis=1, inplace=True)

print("\n=== AFTER FEATURE ENGINEERING ===")
print(df.head())


# Detect outliers in price using IQR method
Q1 = df['price'].quantile(0.25)
Q3 = df['price'].quantile(0.75)
IQR = Q3 - Q1
lower_bound = Q1 - 1.5 * IQR
upper_bound = Q3 + 1.5 * IQR

outliers = df[(df['price'] < lower_bound) | (df['price'] > upper_bound)]
print(f"\nOutliers detected in price: {len(outliers)}")
if len(outliers) > 0:
    print(outliers[['price', 'sqft', 'location']])
    # Cap outliers to bounds (or you could remove them)
    df['price'] = df['price'].clip(lower=lower_bound, upper=upper_bound)


    # Separate features and target
X = df.drop('price', axis=1)
y = df['price']

# Identify categorical and numerical columns
categorical_cols = ['location', 'condition']
numerical_cols = ['bedrooms', 'bathrooms', 'sqft', 'sale_month', 'house_age',
                  'price_per_sqft', 'bed_bath_ratio']

# Create preprocessor
preprocessor = ColumnTransformer(
    transformers=[
        ('num', StandardScaler(), numerical_cols),
        ('cat', OneHotEncoder(drop='first', sparse_output=False), categorical_cols)
    ])

# Apply transformations
X_processed = preprocessor.fit_transform(X)

print("\n=== AFTER ENCODING & SCALING ===")
print(f"Original features: {X.shape[1]}")
print(f"Processed features: {X_processed.shape[1]}")
print(f"First 3 rows of processed data:\n{X_processed[:3]}")


# Split into training (80%) and testing (20%)
X_train, X_test, y_train, y_test = train_test_split(
    X_processed, y, test_size=0.2, random_state=42
)

print("\n=== DATA SPLIT ===")
print(f"Training set size: {X_train.shape[0]} samples")
print(f"Test set size: {X_test.shape[0]} samples")


print("\n=== FINAL CLEAN DATASET (first 5 rows) ===")
print(df.round(2).head())
print(f"\nDataset shape: {df.shape}")
print(f"Data types:\n{df.dtypes}")
