<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NOVA — AI Assistant</title>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --bg-deep:    #07080f;
  --bg-mid:     #0d0e1c;
  --glass:      rgba(255,255,255,0.05);
  --glass-b:    rgba(255,255,255,0.10);
  --glass-h:    rgba(255,255,255,0.08);
  --border:     rgba(255,255,255,0.09);
  --border-h:   rgba(255,255,255,0.18);
  --a1: #5b8dee;
  --a2: #9b5dff;
  --a3: #00d4aa;
  --a4: #ff6b9d;
  --text:       #e8eaf0;
  --text-s:     rgba(232,234,240,0.6);
  --text-m:     rgba(232,234,240,0.35);
  --user-bg:    rgba(91,141,238,0.15);
  --user-bord:  rgba(91,141,238,0.3);
  --ai-bg:      rgba(255,255,255,0.04);
  --ai-bord:    rgba(255,255,255,0.09);
}

html, body { height: 100%; overflow: hidden; }

body {
  font-family: 'Sora', sans-serif;
  background: var(--bg-deep);
  color: var(--text);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

/* ── Animated BG ── */
.bg-orbs {
  position: fixed; inset: 0; pointer-events: none; z-index: 0; overflow: hidden;
}
.orb {
  position: absolute; border-radius: 50%;
  filter: blur(80px); opacity: 0.18;
  animation: orbDrift 18s ease-in-out infinite alternate;
}
.orb1 { width: 500px; height: 500px; background: var(--a2); top: -150px; left: -100px; animation-delay: 0s; }
.orb2 { width: 400px; height: 400px; background: var(--a1); bottom: -100px; right: -80px; animation-delay: -7s; }
.orb3 { width: 300px; height: 300px; background: var(--a3); top: 40%; left: 40%; animation-delay: -13s; opacity: 0.10; }

@keyframes orbDrift {
  from { transform: translate(0,0) scale(1); }
  to   { transform: translate(40px, 30px) scale(1.1); }
}

/* Grid overlay */
.bg-grid {
  position: fixed; inset: 0; pointer-events: none; z-index: 0;
  background-image:
    linear-gradient(rgba(255,255,255,0.018) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,0.018) 1px, transparent 1px);
  background-size: 52px 52px;
}

/* ── Shell ── */
.shell {
  position: relative; z-index: 1;
  width: 100vw; height: 100vh;
  max-width: 820px;
  display: flex; flex-direction: column;
  margin: 0 auto;
  padding: 0 0 0 0;
}

/* ── Topbar ── */
.topbar {
  display: flex; align-items: center;
  padding: 18px 28px;
  border-bottom: 1px solid var(--border);
  background: rgba(7,8,15,0.7);
  backdrop-filter: blur(24px);
  flex-shrink: 0;
}

.nova-logo {
  display: flex; align-items: center; gap: 12px;
}

.nova-avatar {
  width: 40px; height: 40px; border-radius: 12px;
  background: linear-gradient(135deg, var(--a2), var(--a1));
  display: flex; align-items: center; justify-content: center;
  font-size: 18px; font-weight: 700; color: white;
  letter-spacing: -1px;
  position: relative; overflow: hidden;
  flex-shrink: 0;
}
.nova-avatar::after {
  content: '';
  position: absolute; inset: 0;
  background: linear-gradient(135deg, rgba(255,255,255,0.2), transparent);
}
.nova-avatar-glow {
  position: absolute; inset: -2px;
  border-radius: 14px;
  background: linear-gradient(135deg, var(--a2), var(--a1));
  z-index: -1;
  opacity: 0;
  transition: opacity 0.3s;
  filter: blur(6px);
}
.nova-logo:hover .nova-avatar-glow { opacity: 0.6; }

.nova-info { display: flex; flex-direction: column; gap: 2px; }
.nova-name {
  font-size: 16px; font-weight: 600; letter-spacing: -0.01em;
  background: linear-gradient(90deg, #e8eaf0, #b8c0ff);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
}
.nova-status {
  display: flex; align-items: center; gap: 6px;
  font-size: 11.5px; color: var(--text-m);
}
.status-dot {
  width: 6px; height: 6px; border-radius: 50%;
  background: var(--a3);
  box-shadow: 0 0 6px var(--a3);
  animation: blink 2.5s ease infinite;
}
@keyframes blink { 0%,100%{opacity:1} 50%{opacity:0.4} }

.topbar-actions { margin-left: auto; display: flex; gap: 8px; }

.top-btn {
  background: var(--glass);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 7px 14px;
  font-family: 'Sora', sans-serif;
  font-size: 12px; font-weight: 500;
  color: var(--text-s);
  cursor: pointer;
  transition: all 0.2s;
}
.top-btn:hover { background: var(--glass-h); border-color: var(--border-h); color: var(--text); }

/* ── Chat Area ── */
.chat-area {
  flex: 1; overflow-y: auto;
  padding: 32px 28px;
  display: flex; flex-direction: column; gap: 20px;
  scroll-behavior: smooth;
}

.chat-area::-webkit-scrollbar { width: 4px; }
.chat-area::-webkit-scrollbar-track { background: transparent; }
.chat-area::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.08); border-radius: 2px; }

/* Welcome screen */
.welcome {
  display: flex; flex-direction: column; align-items: center;
  justify-content: center; text-align: center;
  flex: 1; padding: 40px 20px;
  animation: fadeUp 0.6s ease both;
}

.welcome-orb {
  width: 72px; height: 72px; border-radius: 22px;
  background: linear-gradient(135deg, var(--a2) 0%, var(--a1) 100%);
  display: flex; align-items: center; justify-content: center;
  font-size: 32px; margin-bottom: 20px;
  box-shadow: 0 16px 48px rgba(155,93,255,0.35);
  position: relative;
}
.welcome-orb::before {
  content: '';
  position: absolute; inset: -8px;
  border-radius: 30px;
  background: linear-gradient(135deg, var(--a2), var(--a1));
  opacity: 0.15; filter: blur(16px);
  z-index: -1;
}

.welcome h2 {
  font-size: 26px; font-weight: 700; letter-spacing: -0.03em;
  margin-bottom: 10px;
  background: linear-gradient(135deg, #e8eaf0 0%, #b8c0ff 60%, #7dd3fc 100%);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
}
.welcome p { font-size: 14px; color: var(--text-s); line-height: 1.7; max-width: 360px; }

.suggest-grid {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 10px; margin-top: 28px; width: 100%; max-width: 480px;
}

.suggest-btn {
  background: var(--glass);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 13px 16px;
  text-align: left;
  cursor: pointer;
  transition: all 0.22s;
  font-family: 'Sora', sans-serif;
}
.suggest-btn:hover {
  background: rgba(91,141,238,0.1);
  border-color: rgba(91,141,238,0.3);
  transform: translateY(-2px);
}
.suggest-icon { font-size: 18px; margin-bottom: 6px; display: block; }
.suggest-text { font-size: 12px; font-weight: 500; color: var(--text-s); line-height: 1.4; }

/* ── Message Bubbles ── */
.msg {
  display: flex; gap: 12px;
  animation: fadeUp 0.35s ease both;
}

.msg.user { flex-direction: row-reverse; }

.msg-avatar {
  width: 34px; height: 34px; border-radius: 10px;
  flex-shrink: 0; display: flex; align-items: center; justify-content: center;
  font-size: 14px; font-weight: 700;
}

.msg.ai .msg-avatar {
  background: linear-gradient(135deg, var(--a2), var(--a1));
  color: white;
  box-shadow: 0 4px 16px rgba(155,93,255,0.3);
}

.msg.user .msg-avatar {
  background: var(--glass-b);
  border: 1px solid var(--border-h);
  color: var(--text-s);
}

.msg-body { flex: 1; max-width: 78%; }

.msg.user .msg-body { display: flex; justify-content: flex-end; }

.bubble {
  display: inline-block;
  padding: 13px 18px;
  border-radius: 16px;
  font-size: 14px; line-height: 1.7;
  max-width: 100%;
}

.msg.ai .bubble {
  background: var(--ai-bg);
  border: 1px solid var(--ai-bord);
  border-top-left-radius: 4px;
  color: var(--text);
}

.msg.user .bubble {
  background: var(--user-bg);
  border: 1px solid var(--user-bord);
  border-top-right-radius: 4px;
  color: var(--text);
}

.msg-time {
  font-size: 10.5px; color: var(--text-m);
  margin-top: 5px;
  font-family: 'JetBrains Mono', monospace;
  padding: 0 4px;
}
.msg.user .msg-time { text-align: right; }

/* Typing dots */
.typing-bubble {
  background: var(--ai-bg);
  border: 1px solid var(--ai-bord);
  border-top-left-radius: 4px;
  border-radius: 16px;
  padding: 14px 20px;
  display: flex; gap: 5px; align-items: center;
}
.typing-dot {
  width: 7px; height: 7px; border-radius: 50%;
  background: var(--a2);
  animation: typingBounce 1.3s ease infinite;
}
.typing-dot:nth-child(2) { animation-delay: 0.18s; background: var(--a1); }
.typing-dot:nth-child(3) { animation-delay: 0.36s; background: var(--a3); }

@keyframes typingBounce {
  0%,60%,100% { transform: translateY(0); opacity: 0.5; }
  30%          { transform: translateY(-7px); opacity: 1; }
}

/* Formatted AI response */
.bubble p { margin-bottom: 10px; }
.bubble p:last-child { margin-bottom: 0; }
.bubble strong { color: #c4b5fd; font-weight: 600; }
.bubble em { color: #7dd3fc; font-style: italic; }
.bubble code {
  font-family: 'JetBrains Mono', monospace;
  font-size: 12px;
  background: rgba(0,0,0,0.35);
  border: 1px solid rgba(255,255,255,0.08);
  padding: 2px 7px; border-radius: 5px;
  color: #86efac;
}
.bubble pre {
  background: rgba(0,0,0,0.4);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 10px;
  padding: 14px 16px;
  overflow-x: auto;
  margin: 10px 0;
  font-family: 'JetBrains Mono', monospace;
  font-size: 12px;
  line-height: 1.65;
  color: #e2e8f0;
}
.bubble ul, .bubble ol { padding-left: 20px; margin: 8px 0; }
.bubble li { margin-bottom: 5px; }
.bubble h1,.bubble h2,.bubble h3 {
  font-weight: 600; margin: 12px 0 6px;
  background: linear-gradient(90deg, #e8eaf0, #b8c0ff);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
}
.bubble h1 { font-size: 16px; }
.bubble h2 { font-size: 15px; }
.bubble h3 { font-size: 14px; }
.bubble a { color: var(--a1); text-decoration: underline; text-underline-offset: 3px; }
.bubble hr { border: none; border-top: 1px solid var(--border); margin: 12px 0; }
.bubble blockquote {
  border-left: 3px solid var(--a2);
  padding: 4px 14px;
  margin: 8px 0;
  color: var(--text-s);
  font-style: italic;
}

/* ── Input Bar ── */
.input-bar {
  padding: 16px 20px 20px;
  border-top: 1px solid var(--border);
  background: rgba(7,8,15,0.8);
  backdrop-filter: blur(24px);
  flex-shrink: 0;
}

.input-wrap {
  display: flex; align-items: flex-end; gap: 10px;
  background: rgba(255,255,255,0.05);
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 10px 10px 10px 18px;
  transition: border-color 0.2s, box-shadow 0.2s;
}

.input-wrap:focus-within {
  border-color: rgba(91,141,238,0.5);
  box-shadow: 0 0 0 3px rgba(91,141,238,0.08), 0 0 40px rgba(91,141,238,0.06);
}

#userInput {
  flex: 1;
  background: transparent;
  border: none; outline: none;
  resize: none;
  font-family: 'Sora', sans-serif;
  font-size: 14px;
  color: var(--text);
  line-height: 1.55;
  max-height: 140px;
  min-height: 24px;
  overflow-y: auto;
}

#userInput::placeholder { color: var(--text-m); }
#userInput::-webkit-scrollbar { width: 3px; }
#userInput::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 2px; }

.send-btn {
  width: 38px; height: 38px;
  border-radius: 11px;
  border: none; cursor: pointer;
  background: linear-gradient(135deg, var(--a2), var(--a1));
  color: white;
  font-size: 16px;
  display: flex; align-items: center; justify-content: center;
  transition: transform 0.18s, box-shadow 0.18s, opacity 0.18s;
  flex-shrink: 0;
  box-shadow: 0 4px 16px rgba(91,141,238,0.35);
}
.send-btn:hover { transform: scale(1.07); box-shadow: 0 6px 22px rgba(91,141,238,0.5); }
.send-btn:active { transform: scale(0.95); }
.send-btn:disabled { opacity: 0.4; cursor: not-allowed; transform: none; box-shadow: none; }

.input-hint {
  font-size: 11px; color: var(--text-m);
  text-align: center; margin-top: 10px;
  display: flex; align-items: center; justify-content: center; gap: 8px;
}
.hint-key {
  background: rgba(255,255,255,0.06);
  border: 1px solid var(--border);
  border-radius: 5px;
  padding: 1px 7px;
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  color: var(--text-m);
}

/* ── Animations ── */
@keyframes fadeUp { from { opacity:0; transform:translateY(12px); } to { opacity:1; transform:translateY(0); } }

/* Streaming cursor */
.stream-cursor::after {
  content: '▋';
  display: inline;
  color: var(--a2);
  animation: cursorBlink 0.8s ease infinite;
  font-size: 12px;
  margin-left: 1px;
}
@keyframes cursorBlink { 0%,100%{opacity:1} 50%{opacity:0} }

/* Toast */
.toast {
  position: fixed; bottom: 80px; left: 50%; transform: translateX(-50%);
  background: rgba(30,32,50,0.95);
  border: 1px solid var(--border-h);
  border-radius: 12px;
  padding: 10px 20px;
  font-size: 13px;
  color: var(--text-s);
  backdrop-filter: blur(16px);
  z-index: 999;
  animation: toastIn 0.3s ease both;
  display: none;
}
.toast.show { display: block; }
@keyframes toastIn { from{opacity:0;transform:translateX(-50%) translateY(10px)} to{opacity:1;transform:translateX(-50%) translateY(0)} }
</style>
</head>
<body>

<div class="bg-orbs">
  <div class="orb orb1"></div>
  <div class="orb orb2"></div>
  <div class="orb orb3"></div>
</div>
<div class="bg-grid"></div>

<div class="shell">

  <!-- Topbar -->
  <div class="topbar">
    <div class="nova-logo">
      <div style="position:relative">
        <div class="nova-avatar-glow"></div>
        <div class="nova-avatar">N</div>
      </div>
      <div class="nova-info">
        <div class="nova-name">NOVA</div>
        <div class="nova-status">
          <div class="status-dot"></div>
          Powered by Claude · Always Online
        </div>
      </div>
    </div>
    <div class="topbar-actions">
      <button class="top-btn" onclick="clearChat()">✦ Clear</button>
    </div>
  </div>

  <!-- Chat area -->
  <div class="chat-area" id="chatArea">
    <div class="welcome" id="welcomeScreen">
      <div class="welcome-orb">✦</div>
      <h2>Hi, I'm NOVA</h2>
      <p>Your AI assistant powered by Claude. Ask me anything — science, history, coding, math, creative writing, and more.</p>
      <div class="suggest-grid">
        <button class="suggest-btn" onclick="sendSuggestion(this)">
          <span class="suggest-icon">🌍</span>
          <div class="suggest-text">Explain how black holes work</div>
        </button>
        <button class="suggest-btn" onclick="sendSuggestion(this)">
          <span class="suggest-icon">💻</span>
          <div class="suggest-text">Write a Python web scraper</div>
        </button>
        <button class="suggest-btn" onclick="sendSuggestion(this)">
          <span class="suggest-icon">🧬</span>
          <div class="suggest-text">How does DNA replication work?</div>
        </button>
        <button class="suggest-btn" onclick="sendSuggestion(this)">
          <span class="suggest-icon">📊</span>
          <div class="suggest-text">Explain machine learning to me</div>
        </button>
      </div>
    </div>
  </div>

  <!-- Input -->
  <div class="input-bar">
    <div class="input-wrap">
      <textarea id="userInput" rows="1" placeholder="Ask me anything…"
        onkeydown="handleKey(event)" oninput="autoResize(this)"></textarea>
      <button class="send-btn" id="sendBtn" onclick="sendMessage()">➤</button>
    </div>
    <div class="input-hint">
      Press <span class="hint-key">Enter</span> to send &nbsp;·&nbsp;
      <span class="hint-key">Shift+Enter</span> for new line
    </div>
  </div>

</div>

<div class="toast" id="toast"></div>

<script>
const chatArea = document.getElementById('chatArea');
const userInput = document.getElementById('userInput');
const sendBtn = document.getElementById('sendBtn');

let conversationHistory = [];
let isStreaming = false;

function getTime() {
  return new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
}

function hideWelcome() {
  const w = document.getElementById('welcomeScreen');
  if (w) w.remove();
}

function autoResize(el) {
  el.style.height = 'auto';
  el.style.height = Math.min(el.scrollHeight, 140) + 'px';
}

function handleKey(e) {
  if (e.key === 'Enter' && !e.shiftKey) {
    e.preventDefault();
    sendMessage();
  }
}

function sendSuggestion(btn) {
  const text = btn.querySelector('.suggest-text').textContent;
  userInput.value = text;
  autoResize(userInput);
  sendMessage();
}

function scrollBottom() {
  chatArea.scrollTop = chatArea.scrollHeight;
}

function showToast(msg, duration = 2500) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), duration);
}

function addMessage(role, content, streaming = false) {
  const div = document.createElement('div');
  div.className = `msg ${role}`;

  const avatarText = role === 'ai' ? 'N' : '👤';
  const avatarEl = `<div class="msg-avatar">${avatarText}</div>`;

  const bubbleId = 'bubble-' + Date.now();
  const html = role === 'ai'
    ? `<div class="msg-body">
        <div class="bubble${streaming ? ' stream-cursor' : ''}" id="${bubbleId}">${content}</div>
        <div class="msg-time">${getTime()}</div>
      </div>`
    : `<div class="msg-body">
        <div class="bubble">${escapeHtml(content)}</div>
        <div class="msg-time">${getTime()}</div>
      </div>`;

  div.innerHTML = role === 'ai'
    ? avatarEl + html
    : html + avatarEl;

  chatArea.appendChild(div);
  scrollBottom();
  return bubbleId;
}

function addTyping() {
  const div = document.createElement('div');
  div.className = 'msg ai';
  div.id = 'typingIndicator';
  div.innerHTML = `
    <div class="msg-avatar">N</div>
    <div class="msg-body">
      <div class="typing-bubble">
        <div class="typing-dot"></div>
        <div class="typing-dot"></div>
        <div class="typing-dot"></div>
      </div>
    </div>`;
  chatArea.appendChild(div);
  scrollBottom();
}

function removeTyping() {
  const t = document.getElementById('typingIndicator');
  if (t) t.remove();
}

function escapeHtml(s) {
  return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}

// Simple markdown parser
function parseMarkdown(text) {
  let html = escapeHtml(text);

  // Code blocks
  html = html.replace(/```(\w*)\n?([\s\S]*?)```/g, (_, lang, code) =>
    `<pre><code>${code.trim()}</code></pre>`);

  // Inline code
  html = html.replace(/`([^`\n]+)`/g, '<code>$1</code>');

  // Headers
  html = html.replace(/^### (.+)$/gm, '<h3>$1</h3>');
  html = html.replace(/^## (.+)$/gm, '<h2>$1</h2>');
  html = html.replace(/^# (.+)$/gm, '<h1>$1</h1>');

  // Bold & italic
  html = html.replace(/\*\*\*(.+?)\*\*\*/g, '<strong><em>$1</em></strong>');
  html = html.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
  html = html.replace(/\*(.+?)\*/g, '<em>$1</em>');

  // Blockquote
  html = html.replace(/^&gt; (.+)$/gm, '<blockquote>$1</blockquote>');

  // HR
  html = html.replace(/^---$/gm, '<hr>');

  // Unordered lists
  html = html.replace(/((?:^[•\-\*] .+\n?)+)/gm, (match) => {
    const items = match.trim().split('\n')
      .map(l => `<li>${l.replace(/^[•\-\*] /, '')}</li>`).join('');
    return `<ul>${items}</ul>`;
  });

  // Ordered lists
  html = html.replace(/((?:^\d+\. .+\n?)+)/gm, (match) => {
    const items = match.trim().split('\n')
      .map(l => `<li>${l.replace(/^\d+\. /, '')}</li>`).join('');
    return `<ol>${items}</ol>`;
  });

  // Paragraphs
  html = html.split(/\n\n+/).map(block => {
    block = block.trim();
    if (!block) return '';
    if (/^<(h[123]|ul|ol|pre|blockquote|hr)/.test(block)) return block;
    return `<p>${block.replace(/\n/g, '<br>')}</p>`;
  }).join('');

  return html;
}

async function sendMessage() {
  if (isStreaming) return;
  const text = userInput.value.trim();
  if (!text) return;

  hideWelcome();
  isStreaming = true;
  sendBtn.disabled = true;
  userInput.value = '';
  userInput.style.height = 'auto';

  // Add user message
  addMessage('user', text);

  // Track in history
  conversationHistory.push({ role: 'user', content: text });

  // Show typing
  addTyping();

  try {
    const response = await fetch('https://api.anthropic.com/v1/messages', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        model: 'claude-sonnet-4-20250514',
        max_tokens: 1000,
        system: `You are NOVA, a brilliant and friendly AI assistant. You have vast knowledge across all topics: science, history, technology, mathematics, literature, culture, coding, philosophy, and more. 

You respond in a clear, engaging, and well-structured way. Use markdown formatting when appropriate (headings, bold, code blocks, lists). Be thorough but not verbose. Be accurate, helpful, and conversational. If asked about yourself, say you are NOVA, an AI assistant.`,
        messages: conversationHistory
      })
    });

    removeTyping();

    if (!response.ok) {
      const err = await response.json();
      throw new Error(err.error?.message || 'API error ' + response.status);
    }

    const data = await response.json();
    const fullText = data.content.map(b => b.text || '').join('');

    // Add AI message
    const bubbleId = addMessage('ai', parseMarkdown(fullText));

    // Track in history
    conversationHistory.push({ role: 'assistant', content: fullText });

    scrollBottom();

  } catch (err) {
    removeTyping();
    console.error(err);
    const msg = err.message.includes('401') || err.message.includes('auth')
      ? '🔑 API key missing or invalid. Please set your Anthropic API key.'
      : err.message.includes('overloaded')
      ? '⚡ Server overloaded — try again in a moment.'
      : '⚠️ Error: ' + err.message;

    addMessage('ai', `<p style="color:#f87171">${msg}</p>`);
    showToast('Something went wrong — see message above');
  }

  isStreaming = false;
  sendBtn.disabled = false;
  userInput.focus();
  scrollBottom();
}

function clearChat() {
  conversationHistory = [];
  chatArea.innerHTML = '';
  // Re-add welcome
  const w = document.createElement('div');
  w.className = 'welcome';
  w.id = 'welcomeScreen';
  w.innerHTML = `
    <div class="welcome-orb">✦</div>
    <h2>Hi, I'm NOVA</h2>
    <p>Your AI assistant powered by Claude. Ask me anything — science, history, coding, math, creative writing, and more.</p>
    <div class="suggest-grid">
      <button class="suggest-btn" onclick="sendSuggestion(this)">
        <span class="suggest-icon">🌍</span>
        <div class="suggest-text">Explain how black holes work</div>
      </button>
      <button class="suggest-btn" onclick="sendSuggestion(this)">
        <span class="suggest-icon">💻</span>
        <div class="suggest-text">Write a Python web scraper</div>
      </button>
      <button class="suggest-btn" onclick="sendSuggestion(this)">
        <span class="suggest-icon">🧬</span>
        <div class="suggest-text">How does DNA replication work?</div>
      </button>
      <button class="suggest-btn" onclick="sendSuggestion(this)">
        <span class="suggest-icon">📊</span>
        <div class="suggest-text">Explain machine learning to me</div>
      </button>
    </div>`;
  chatArea.appendChild(w);
  showToast('Chat cleared ✓');
}

userInput.focus();
</script>
</body>
